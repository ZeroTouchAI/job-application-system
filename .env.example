# Postgres connection string. Works with any Postgres host:
# Neon, Railway, Supabase-as-plain-Postgres, or local Docker.
DATABASE_URL="postgresql://user:password@localhost:5432/groundwork"

# Groq API key — used for grounded resume/cover-letter generation.
# Free tier, no credit card required: get one at https://console.groq.com
GROQ_API_KEY="gsk_..."

# Optional overrides — defaults shown. Only change these if Groq
# deprecates the default model or you want to point at a different
# OpenAI-compatible provider entirely.
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# GROQ_MODEL="openai/gpt-oss-120b"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Optional: comma-separated Greenhouse company board slugs to include
# in every user's job sync by default (users can add their own too).
# e.g. GREENHOUSE_DEFAULT_BOARDS="stripe,airbnb"
GREENHOUSE_DEFAULT_BOARDS=""

# Optional: comma-separated Lever company slugs, same idea.
LEVER_DEFAULT_BOARDS=""

# Optional: how many job cards the swipe deck serves per rolling 24 hours (default 10).
# DAILY_DECK_SIZE=10

# --- Canada-only mode (default on). Set to "false" to re-enable US/EU sources.
# CANADA_ONLY="true"

# Starter Canadian employer boards (lib/sources/seedBoards.ts). "off" disables.
# SEED_CANADIAN_BOARDS="on"

# Optional: comma-separated Ashby board slugs (jobs.ashbyhq.com/<slug>).
ASHBY_DEFAULT_BOARDS=""

# --- Optional paid/keyed sources (all no-op when unset) ---

# Adzuna (Canada). Free key at developer.adzuna.com. Evaluation use only;
# a public launch needs a commercial licence (docs/sources.md).
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# ADZUNA_COUNTRY="ca"

# Apify job boards (Indeed + LinkedIn). Read docs/scraping-policy.md first.
APIFY_TOKEN=""
# APIFY_BOARDS_ACTOR="agentx~all-jobs-scraper"
# APIFY_BOARD_PLATFORMS="Indeed,LinkedIn"
# APIFY_COUNTRY="Canada"
# Spend guard (lib/sources/budget.ts, docs/budget.md). Prices are the actor's
# FREE-plan prices read on 2026-11-05; update if the listing changes.
APIFY_MONTHLY_BUDGET_USD="4.50"
APIFY_RUNS_PER_MONTH="11"
# APIFY_START_PRICE_USD="0.01"
# APIFY_RESULT_PRICE_USD="0.0035"
